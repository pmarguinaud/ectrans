SUBROUTINE ADD_PRESENT(N, A, B, C, D, K)
INTEGER :: N, J, K
REAL :: A(N), B(N), C(N)
REAL, OPTIONAL :: D(N)
!$ACC DATA PRESENT(A,B)
!$ACC DATA PRESENT(C) IF(K > 0)
!$ACC DATA PRESENT(D) IF(PRESENT(D))
!$ACC PARALLEL LOOP DEFAULT(NONE) FIRSTPRIVATE(N) ASYNC(1) PRESENT(A,B)
DO J=1,N
  A(J) = B(J)
ENDDO
!$ACC PARALLEL LOOP DEFAULT(NONE) FIRSTPRIVATE(N) &
!$ACC& PRESENT(A,B) ! comment
DO J=1,N
  A(J) = C(J) + D(J) + B(J)
ENDDO
!$ACC PARALLEL LOOP DEFAULT(NONE) FIRSTPRIVATE(N) COPYIN(K)
DO J=1,N
  A(J) = K
ENDDO
!$ACC PARALLEL LOOP FIRSTPRIVATE(N) PRESENT(A)
DO J=1,N
  A(J) = 0.
ENDDO
!$ACC END DATA
!$ACC END DATA
!$ACC END DATA
END SUBROUTINE
