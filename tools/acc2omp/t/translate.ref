SUBROUTINE TRANSLATE(N, A, B, C, P)
! acc2omp.pl translation: one case per row of the table
INTEGER :: N, J, K
REAL :: A(N,N), B(N,N), C(N)
REAL, OPTIONAL :: P(N)
!$OMP TARGET DATA MAP(PRESENT,ALLOC:A) MAP(TO:B) MAP(FROM:C) IF(N > 0)
!$OMP TARGET DATA MAP(TOFROM:A) MAP(ALLOC:B)
!$OMP END TARGET DATA
!$OMP TARGET TEAMS DISTRIBUTE PARALLEL DO &
!$OMP& COLLAPSE(2) PRIVATE(K) &
!$OMP& FIRSTPRIVATE(N) MAP(PRESENT,ALLOC:A,B)
DO J=1,N
  DO K=1,N
    A(K,J) = B(K,J)
  ENDDO
ENDDO
!$OMP TARGET TEAMS DISTRIBUTE PARALLEL DO &
!$OMP& COLLAPSE(2) MAP(PRESENT,ALLOC:A,B,C(1:N),B)
DO J=1,N

  DO K=1,N
    A(K,J) = A(K,J) + B(K,J)
  ENDDO
ENDDO
!$OMP END TARGET TEAMS DISTRIBUTE PARALLEL DO
!$OMP TARGET UPDATE FROM(A) TO(B) IF(N > 1)


!$OMP TARGET DATA USE_DEVICE_ADDR(A,B)
CALL SOMETHING(A, B)
!$OMP END TARGET DATA
!$OMP END TARGET DATA
!$OMP TARGET ENTER DATA MAP(TO:A) MAP(ALLOC:B) IF(N > 0)
!$OMP TARGET EXIT DATA MAP(DELETE:B) MAP(FROM:A) IF(N > 0)
! optional argument: P is dropped from PRESENT on the loop, also inside a hand-written pair
#ifdef ACCGPU
!$ACC DATA PRESENT(A,P) IF(PRESENT(P))
#endif
#ifdef OMPGPU
!$OMP TARGET DATA MAP(PRESENT,ALLOC:A,P) IF(PRESENT(P))
#endif
IF (PRESENT(P)) THEN
!$OMP TARGET TEAMS DISTRIBUTE PARALLEL DO MAP(PRESENT,ALLOC:A)
DO J=1,N
  A(J,1) = P(J)
ENDDO
ENDIF
#ifdef ACCGPU
!$ACC END DATA
#endif
#ifdef OMPGPU
!$OMP END TARGET DATA
#endif
!$OMP TARGET TEAMS DISTRIBUTE PARALLEL DO MAP(PRESENT,ALLOC:P)
DO J=1,N
  P(J) = 0.
ENDDO
END SUBROUTINE
